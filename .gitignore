# Git ignore for SGIF Monorepo

# Rust
target/
**/*.rs.bk
# Cargo.lock is committed for reproducible builds

# Node / Web
node_modules/
apps/web/dist/
apps/web/.env
*.env
!*.env.example

# Flutter
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/build/
apps/mobile/.packages

# Supabase
supabase/.env
supabase/.temp/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
