# SGIF Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit .env!

# Supabase Postgres connection string (Session mode via pgBouncer)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# JWT secret — same value as SUPABASE_JWT_SECRET in your Supabase project
JWT_SECRET=your-supabase-jwt-secret

# Server port
PORT=3000

# Log level: trace | debug | info | warn | error
RUST_LOG=sgif_backend=debug,tower_http=info

# CORS allowed origin
ALLOWED_ORIGIN=http://localhost:5173
